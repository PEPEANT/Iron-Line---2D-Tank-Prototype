{
  "name": "iron-line-2d-tank-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Static 2D tank and infantry prototype.",
  "scripts": {
    "start": "node tools/static-server.cjs",
    "check": "node tools/check-syntax.cjs && node tools/check-duplicates.cjs && node tools/check-code-health.cjs && node tools/check-asset-pack.cjs",
    "check:online": "node tools/check-online-smoke.cjs",
    "census": "node tools/check-behavior-census.cjs",
    "bed:combat": "node tools/check-bed-combat-census.cjs",
    "tank:assault": "node tools/check-infantry-tank-assault.cjs",
    "tempo": "node tools/check-battlefield-tempo.cjs",
    "health": "node tools/code-health-report.cjs",
    "heal": "npm run check && npm run health"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ws": "^8.21.0"
  }
}
